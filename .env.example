FLASK_APP=app.py
FLASK_ENV=production
FLASK_PORT=5000
JWT_SECRET_KEY=change-this-to-a-random-string-in-production

# ═══════════════════════════════════════════════════════════
#  Database Configuration
# ═══════════════════════════════════════════════════════════

# 本地开发（SQLite，无需安装 MySQL）
DATABASE_URL=sqlite:///pivot.db

# 本地开发（MySQL）— 需先按 setup_mysql.md 安装配置
# DATABASE_URL=mysql+pymysql://pivot_user:PivotPass123!@localhost:3306/pivot_db

# Railway 生产环境（自动注入，格式示例）
# DATABASE_URL=mysql://root:xxxxxxxx@mysql.railway.internal:3306/railway

# ═══════════════════════════════════════════════════════════
#  Moonshot AI (Kimi) API Key
#  Get yours at: https://platform.moonshot.cn/
# ═══════════════════════════════════════════════════════════
MOONSHOT_API_KEY=sk-your-moonshot-api-key-here

# ═══════════════════════════════════════════════════════════
#  Email (Resend HTTP API) — Required for password reset
#  Railway blocks outbound SMTP; use Resend (HTTPS) instead.
#  1) Sign up at https://resend.com and create an API key
#  2) For quick test: EMAIL_FROM=Pivot <onboarding@resend.dev>
#  3) After DNS verify on your domain (e.g. internmatch.blog):
#     EMAIL_FROM=Pivot <noreply@internmatch.blog>
# ═══════════════════════════════════════════════════════════
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=Pivot <noreply@internmatch.blog>
# EMAIL_FROM_NAME=Pivot
