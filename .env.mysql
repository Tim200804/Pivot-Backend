# Pivot Backend — MySQL 环境变量模板
# 使用方式：复制以下内容到 .env 文件，替换原有的 sqlite 配置

FLASK_APP=app.py
FLASK_ENV=development
FLASK_PORT=5000
JWT_SECRET_KEY=pivot-dev-secret-key-change-in-production

# ═══════════════════════════════════════════════════════════
#  MySQL 连接配置（本地开发）
#  安装 MySQL 并执行 setup_mysql.md 中的步骤后启用
# ═══════════════════════════════════════════════════════════
DATABASE_URL=mysql+pymysql://pivot_user:PivotPass123!@localhost:3306/pivot_db

# 如果 pymysql 驱动有问题，可尝试纯 mysql:// 协议（由代码自动处理）
# DATABASE_URL=mysql://pivot_user:PivotPass123!@localhost:3306/pivot_db

MOONSHOT_API_KEY=sk-D8vu7xHA4EEPZIwoJ0Jst8V2ssCXbBHBBl4VzSUrHMjLZSuD
